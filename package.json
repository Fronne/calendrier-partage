{
  "name": "calendrier-partage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-dev.mjs && wrangler d1 migrations apply calendrier --local",
    "dev": "vite build && concurrently -k -n api,web \"wrangler dev --port 8787 --test-scheduled\" \"vite\"",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc -p . && tsc -p worker",
    "icons": "node scripts/gen-icons.mjs",
    "apk": "cd android && .\\gradlew.bat assembleRelease",
    "db:remote": "wrangler d1 migrations apply calendrier --remote",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250124.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "^3.114.0"
  }
}
